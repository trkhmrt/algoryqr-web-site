API_BASE_URL=http://localhost:8055
PUBLIC_API_BASE_URL=http://localhost:8055
# Public site URL (SEO canonical, Open Graph, sitemap). Prod: https://qr.algorycode.com
APP_URL=http://localhost:3000

QR_MCP_BASE_URL=https://prod.qr-mcp.algorycode.com
QR_MCP_API_KEY=qr-mcp-local-dev-key-change-in-prod
QR_AGENT_BASE_URL=http://localhost:3200

AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-ai-service-key

# Contact form mail (same mail-api as AlgoryCode)
# POST {MAIL_API_BASE_URL}/api/v1/mails — admin: REQUEST_FORM, user: GENERIC
MAIL_API_BASE_URL=https://prod.mail.api.algorycode.com
MAIL_NOTIFY_TO=info@algorycode.com

# Smart summary (Akıllı Özet): site BFF POST /api/smart-summary
# proxies ai-service POST /api/v1/product-descriptions (OpenAI Responses API).

# Smart reports: site BFF proxies qr-service (API_BASE_URL).
# Schema contract for qr-service tables/events/results/last_usage:
#   docs/smart-report-data-model.md
#   docs/smart-report-qr-service-migration.sql

# Google OAuth path map (must stay in sync with qr-service Coolify env):
# 1) Site start:        /api/auth/google/start
# 2) API authorize:     {PUBLIC_API_BASE_URL}/google-auth/authorize
# 3) Google -> API:     GOOGLE_CALLBACK_URL = {API}/google-auth/callback
# 4) API -> Site:       GOOGLE_FRONTEND_CALLBACK_URL = {APP_URL}/api/auth/google/callback
# Never set GOOGLE_CALLBACK_URL or GOOGLE_FRONTEND_CALLBACK_URL to /auth/google/callback.
# Local frontend callback: http://localhost:3000/api/auth/google/callback
# Prod frontend callback:  https://qr.algorycode.com/api/auth/google/callback
